@bp.post("/employees/sync")
@login_required
@require_perm("devices.manage")
def employees_sync():
    import requests
    db = get_db()
    employees = [dict(r) for r in db.execute("SELECT employee_id,name,card_rfid,s30_password,is_active FROM employees WHERE is_active=1 ORDER BY CAST(employee_id AS INTEGER)").fetchall()]
    agents = db.execute("SELECT * FROM devices WHERE device_type='cashier_pc' AND is_active=1 AND agent_base_url IS NOT NULL AND agent_base_url<>''").fetchall()
    if not agents:
        flash("No agents configured", "error")
        return redirect(url_for("admin.employees"))

    ok, fail = 0, 0
    for a in agents:
        url = a["agent_base_url"].rstrip("/") + "/sync/users"
        try:
            r = requests.post(url, json={"employees": employees}, headers={"X-Aljoud-Agent-Secret": current_app.config.get("AGENT_SHARED_SECRET","")}, timeout=12)
            if r.status_code == 200:
                ok += 1
            else:
                fail += 1
        except Exception:
            fail += 1

    audit("devices.sync_users", {"ok": ok, "fail": fail})
    flash(f"Sync result: ok={ok} fail={fail}", "ok" if fail == 0 else "error")
    return redirect(url_for("admin.employees"))

