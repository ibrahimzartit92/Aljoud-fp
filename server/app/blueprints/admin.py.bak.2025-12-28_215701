@bp.post("/devices/<int:dev_id>/test")
@login_required
@require_perm("devices.manage")
def devices_test(dev_id: int):
    db = get_db()
    d = db.execute("SELECT * FROM devices WHERE id=?", (dev_id,)).fetchone()
    if not d:
        flash("Not found", "error")
        return redirect(url_for("admin.devices"))
    host = d["ip"] or ""
    port = d["port"] or (4370 if d["device_type"] == "s30" else 80)
    ok, ms = tcp_ping(host, int(port))
    grade = grade_latency(ms)
    db.execute("UPDATE devices SET last_seen=?, last_latency_ms=? WHERE id=?",
               (datetime.datetime.now().isoformat(timespec="seconds") if ok else None, ms if ok else None, dev_id))
    db.commit()
    audit("devices.test", {"id": dev_id, "ok": ok, "ms": ms, "grade": grade})
    if ok:
        flash(f"OK - {grade} - {ms}ms", "ok")
    else:
        flash("OFFLINE", "error")
    return redirect(url_for("admin.devices"))

