@bp.get("/roles")
@login_required
@require_perm("roles.manage")
def roles():
    db = get_db()
    roles = db.execute("SELECT * FROM roles ORDER BY name").fetchall()
    perms = db.execute("SELECT * FROM permissions ORDER BY code").fetchall()
    mapping = db.execute("SELECT role_id, perm_code FROM role_permissions").fetchall()
    m = {}
    for r in mapping:
        m.setdefault(r["role_id"], set()).add(r["perm_code"])
    employees = db.execute("SELECT id, employee_id, name, username FROM employees ORDER BY CAST(employee_id AS INTEGER)").fetchall()
    er = db.execute("SELECT employee_id, role_id FROM employee_roles").fetchall()
    er_map = {}
    for r in er:
        er_map.setdefault(r["employee_id"], set()).add(r["role_id"])
    return render_template("admin/roles.html", roles=roles, perms=perms, role_perms=m, employees=employees, er_map=er_map)

