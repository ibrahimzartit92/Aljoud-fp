{% extends "_base.html" %}
{% block content %}
<div class="card">
  <h1 class="h1">{{ t('roles') }}</h1>

  <div class="card" style="margin-top:12px">
    <h2 class="h2">Roles</h2>
    <table>
      <thead><tr><th>Role</th></tr></thead>
      <tbody>
        {% for r in roles %}
          <tr><td>{{ r.name }}</td></tr>
        {% endfor %}
        {% if roles|length==0 %}<tr><td>No roles</td></tr>{% endif %}
      </tbody>
    </table>
  </div>

  <div class="card" style="margin-top:12px;opacity:.85">
    صفحة مبسطة لتفادي 500. بعدين منضيف إدارة الصلاحيات وربطها بالموظفين بشكل كامل.
  </div>
</div>
{% endblock %}
